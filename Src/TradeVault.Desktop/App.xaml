<Application x:Class="TradeVault.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#162D40"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#E8F1F5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#B7CCD5"/><Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#F5F8FA"/><Setter Property="RowHeight" Value="36"/>
      <Setter Property="ColumnHeaderHeight" Value="48"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E2E9EE"/><Setter Property="BorderBrush" Value="#C8D5DF"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#E8EFF4"/><Setter Property="Foreground" Value="#162D40"/>
      <Setter Property="Padding" Value="10,6"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Resources>
</Application>
